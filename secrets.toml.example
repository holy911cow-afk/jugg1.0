# Copy this file to .streamlit/secrets.toml for local use.
# Never commit the real secrets.toml file.
OPENAI_API_KEY = "replace-with-your-key"
OPENAI_MODEL = "gpt-5-mini"

# Optional: public CSV export URL for a Google Sheet or other holdings table.
# Once configured, adding a row to the sheet adds the holding to JUGG without a GitHub update.
PORTFOLIO_DATA_URL = ""
